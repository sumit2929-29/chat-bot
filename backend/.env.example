# Supabase project URL and server-only service role key.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY

# Dify application API. Include /v1 for Dify Cloud or your self-hosted API.
DIFY_API_BASE_URL=https://api.dify.ai/v1
DIFY_API_KEY=YOUR_SERVER_ONLY_DIFY_APP_KEY
# Use "chat" for a published Chatflow/Chatbot app, or "workflow" for a Workflow app.
DIFY_APP_MODE=chat
# Workflow mode only: configure these to match the published workflow's input/output fields.
DIFY_WORKFLOW_INPUT_FIELD=query
DIFY_WORKFLOW_OUTPUT_FIELD=answer
DIFY_TIMEOUT_MS=45000

# Exact browser frontend origin, including scheme and optional port; no path.
ALLOWED_ORIGIN=http://localhost:3000

# Per-session and per-IP message limit.
RATE_LIMIT_MAX_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60

# Use "none" only for a cross-site frontend/backend deployment over HTTPS.
SESSION_COOKIE_SAME_SITE=lax
